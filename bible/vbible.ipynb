   "source": [
    "import json\n",
    "\n",
    "with open('bible.json', 'r', encoding='utf-8') as file:\n",
    "    bible_data = json.load(file)\n",
    "    #return bible_data\n",
    "\n",
    "book=\"삼상\"\n",
    "chap=1\n",
    "verse=1\n",
    "search_key=book+str(chap)+\":\"+str(verse)\n",
    "print(search_key)\n",
    "key_word=bible_data[search_key] \n",
    "print(key_word)   \n",
    "\n",
    "    \n"
   ]
  }
